{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-6.2-sol",
  "default_agent": "orchestrator",
  "experimental": { "subagent_depth": 1 },
  "agents": {
    "orchestrator": {
      "description": "Plans engineering tasks, delegates bounded work, and consolidates evidence",
      "mode": "primary",
      "steps": 12,
      "permissions": [
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "backend", "effect": "allow" },
        { "action": "subagent", "resource": "frontend", "effect": "allow" },
        { "action": "subagent", "resource": "devops", "effect": "allow" },
        { "action": "subagent", "resource": "qa", "effect": "allow" },
        { "action": "subagent", "resource": "security", "effect": "allow" },
        { "action": "subagent", "resource": "documentation", "effect": "allow" },
        { "action": "shell", "resource": "git push *", "effect": "ask" },
        { "action": "shell", "resource": "docker *", "effect": "ask" }
      ]
    }
  }
}
