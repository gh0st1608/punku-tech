{
  "name": "ai-engineering-factory",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm --workspace @aief/orchestration-api run start:dev",
    "dev:web": "npm --workspace @aief/dashboard run dev",
    "build": "npm run build --workspaces --if-present",
    "db:generate": "npm --workspace @aief/orchestration-api run db:generate",
    "db:migrate": "npm --workspace @aief/orchestration-api run db:migrate",
    "lint": "eslint apps packages",
    "lint:fix": "eslint apps packages --fix",
    "format": "prettier --write \"apps/**/*.{ts,tsx}\" \"packages/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx}\" \"packages/**/*.{ts,tsx}\"",
    "test:api": "jest --config jest.config.cjs --runInBand --coverage --json --outputFile=artifacts/qa/jest-results.json",
    "test:e2e": "playwright test --config apps/dashboard/playwright.config.ts",
    "quality-gate": "node scripts/quality-gate.mjs",
    "typecheck": "npm --workspace @aief/orchestration-api run typecheck",
    "quality": "npm run format:check && npm run lint && npm run typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@nestjs/testing": "^11.1.9",
    "@playwright/test": "^1.56.1",
    "@types/jest": "^29.5.14",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-sonarjs": "^3.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.0.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.13",
    "typescript-eslint": "^8.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
